# Ejemplo de archivo de configuración de entorno.
# Copie este archivo a .env y complete con sus credenciales.
# Asegúrese de que el archivo .env esté en su .gitignore para no subirlo al repositorio.

# Credenciales para Coronel Mayorista
CORONEL_CUIT=TU_CUIT_AQUI
CORONEL_PASSWORD=TU_PASSWORD_AQUI

# Credenciales para la API de Tiendanube
TIENDANUBE_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_TIENDANUBE
TIENDANUBE_STORE_ID=TU_ID_DE_TIENDA_TIENDANUBE

# Opcional: Clave API para DeepSeek (si se implementa la funcionalidad de dimensiones con IA)
# DEEPSEEK_API_KEY=TU_CLAVE_API_DEEPSEEK
